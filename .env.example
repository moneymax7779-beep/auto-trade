# Copy to .env (never committed). Local-only defaults.
AUTOTRADE_DB_PASSWORD=autotrade
# zt-tiger-v2 PostgreSQL, read-only (direct replay and the session cloner).
# Its generated password is read from ../zt-tiger-v2/.local/v2/runtime.env automatically.
ZT_SOURCE_URL=jdbc:postgresql://127.0.0.1:5490/trading
ZT_SOURCE_USER=zerotrade
# ZT_SOURCE_PASSWORD_FILE=../zt-tiger-v2/.local/v2/runtime.env
# ZT_SOURCE_PASSWORD=
KEYCLOAK_ADMIN_PASSWORD=admin
