<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <groupId>com.autotrade</groupId>
    <artifactId>autotrade-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>auto-trade</name>

    <modules>
        <module>platform-core</module>
        <module>strategy-config</module>
        <module>marketdata-store</module>
        <module>marketdata-source-zt</module>
        <module>features</module>
        <module>execution-sim</module>
        <module>instrument-master</module>
        <module>strategy-api</module>
        <module>strategy-ecr</module>
        <module>research</module>
        <module>broker-api</module>
        <module>broker-paper</module>
        <module>risk</module>
        <module>oms</module>
        <module>marketdata-live</module>
        <module>broker-upstox</module>
        <module>app-trading-core</module>
        <module>autotrade-tools</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.autotrade</groupId>
                <artifactId>platform-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.autotrade</groupId>
                <artifactId>strategy-config</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.autotrade</groupId>
                <artifactId>marketdata-store</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.autotrade</groupId>
                <artifactId>marketdata-source-zt</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.autotrade</groupId>
                <artifactId>features</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.autotrade</groupId>
                <artifactId>execution-sim</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.autotrade</groupId>
                <artifactId>instrument-master</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.autotrade</groupId>
                <artifactId>strategy-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.autotrade</groupId>
                <artifactId>strategy-ecr</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.autotrade</groupId>
                <artifactId>research</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.autotrade</groupId>
                <artifactId>broker-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.autotrade</groupId>
                <artifactId>broker-paper</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.autotrade</groupId>
                <artifactId>risk</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.autotrade</groupId>
                <artifactId>oms</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.autotrade</groupId>
                <artifactId>marketdata-live</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.autotrade</groupId>
                <artifactId>app-trading-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.autotrade</groupId>
                <artifactId>broker-upstox</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <configuration>
                        <includes>
                            <include>**/*Test.java</include>
                            <include>**/*IT.java</include>
                        </includes>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

    <dependencies>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.platform</groupId>
            <artifactId>junit-platform-launcher</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
