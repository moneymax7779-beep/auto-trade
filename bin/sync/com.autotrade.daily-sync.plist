<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Daily GCP -> Mac market-data sync, weekdays 16:45 (the Mac's clock is IST). If the Mac sleeps through 16:45, launchd
     runs it at wake. Install: cp to ~/Library/LaunchAgents/ and launchctl bootstrap gui/$(id -u) <that file>. -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.autotrade.daily-sync</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/caffeinate</string><string>-i</string>
    <string>/bin/bash</string><string>/Users/satyasiripuram/Desktop/Dev/Code/auto-trade/bin/sync/daily-sync.sh</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict><key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string></dict>
  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Weekday</key><integer>1</integer><key>Hour</key><integer>16</integer><key>Minute</key><integer>45</integer></dict>
    <dict><key>Weekday</key><integer>2</integer><key>Hour</key><integer>16</integer><key>Minute</key><integer>45</integer></dict>
    <dict><key>Weekday</key><integer>3</integer><key>Hour</key><integer>16</integer><key>Minute</key><integer>45</integer></dict>
    <dict><key>Weekday</key><integer>4</integer><key>Hour</key><integer>16</integer><key>Minute</key><integer>45</integer></dict>
    <dict><key>Weekday</key><integer>5</integer><key>Hour</key><integer>16</integer><key>Minute</key><integer>45</integer></dict>
  </array>
  <key>StandardOutPath</key><string>/Users/satyasiripuram/Desktop/Dev/Code/auto-trade/.local/daily-sync/launchd.log</string>
  <key>StandardErrorPath</key><string>/Users/satyasiripuram/Desktop/Dev/Code/auto-trade/.local/daily-sync/launchd.log</string>
</dict>
</plist>
