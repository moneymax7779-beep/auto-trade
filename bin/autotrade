#!/usr/bin/env bash
# Runs the operator CLI from the built jar. Build first: mvn -q -DskipTests install
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$ROOT"
JAR="$(ls autotrade-tools/target/autotrade-tools-*.jar | grep -v original | head -1)"
# The Spring Boot jar embeds the other modules and is not rebuilt when only they change. Running a
# stale jar silently runs old code, so refuse (set AUTOTRADE_ALLOW_STALE=1 to override).
for module_jar in */target/*-SNAPSHOT.jar; do
  if [[ "$module_jar" != autotrade-tools/* && "$module_jar" != app-trading-core/* && "$module_jar" -nt "$JAR" ]]; then
    echo "error: $module_jar is newer than the CLI jar; run: mvn -q -DskipTests -pl autotrade-tools -am clean install" >&2
    [[ "${AUTOTRADE_ALLOW_STALE:-0}" == "1" ]] || exit 3
    break
  fi
done
exec java ${AUTOTRADE_JAVA_OPTS:--Xmx2g} -jar "$JAR" "$@"
